# AI Provider Selection: "groq" or "ollama"
AI_PROVIDER=groq

# Groq API Configuration (Get free key from https://console.groq.com)
AI_API_KEY=your_groq_api_key_here
AI_MODEL=llama-3.2-11b-vision-preview

# Ollama Configuration (Local fallback)
OLLAMA_URL=http://localhost:11434
# AI_MODEL=llava

# Server Configuration
PORT=8000
ALLOWED_ORIGINS=chrome-extension://*,http://localhost:3000,http://localhost:5173,http://127.0.0.1:8000
SERVER_AUTH_TOKEN=
